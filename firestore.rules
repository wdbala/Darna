rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsNewRecord() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /feed/{recordId} {
      allow read: if signedIn();
      allow create: if ownsNewRecord();
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedByMe', 'comments'])
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /{collectionName}/{recordId} {
      allow read: if signedIn() && collectionName in ['jobs', 'marketplace', 'services', 'events'];
      allow create: if collectionName in ['jobs', 'marketplace', 'services', 'events'] && ownsNewRecord();
      allow update: if collectionName in ['jobs', 'marketplace', 'services', 'events'] && signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (collectionName == 'events' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvps', 'rsvpUserIds']) &&
          ((request.auth.uid in resource.data.get('rsvpUserIds', []) &&
            !(request.auth.uid in request.resource.data.get('rsvpUserIds', [])) &&
            request.resource.data.rsvps == resource.data.rsvps - 1) ||
          (!(request.auth.uid in resource.data.get('rsvpUserIds', [])) &&
            request.auth.uid in request.resource.data.get('rsvpUserIds', []) &&
            request.resource.data.rsvps == resource.data.rsvps + 1)))
      );
      allow delete: if collectionName in ['jobs', 'marketplace', 'services', 'events'] &&
        signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /threads/{recordId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if signedIn() && request.auth.uid in resource.data.participantIds &&
        request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    match /messages/{recordId} {
      function isThreadMember(threadId) {
        let threadPath = /databases/$(database)/documents/threads/$(threadId);
        return signedIn() && exists(threadPath) &&
          request.auth.uid in get(threadPath).data.participantIds;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isThreadMember(request.resource.data.threadId) &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.senderId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}