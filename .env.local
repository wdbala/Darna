# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Firebase Web app configuration. These values identify the Firebase project;
# they are not service-account credentials. Keep server secrets out of VITE_* variables.
VITE_FIREBASE_API_KEY="AIzaSyDvGAdnC_neCtnxnuc9SI8Dk42V3MdMuz0"
VITE_FIREBASE_AUTH_DOMAIN="darna-d7df3.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="darna-d7df3"
VITE_FIREBASE_STORAGE_BUCKET="darna-d7df3.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="632299465568"
VITE_FIREBASE_APP_ID="1:632299465568:web:cf2ae456249d12c4878c05"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="darna-d7df3.web.app"
